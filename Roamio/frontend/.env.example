# Node/Express backend (auth, trips, itinerary, and the proxy for recommendations,
# landmarks and image translation). Leave unset to use the local default.
VITE_BACKEND_API_URL=http://127.0.0.1:3000

# FastAPI ai-features service - only used directly for weather (no secret needed).
# Leave unset to use the local default of http://127.0.0.1:8000.
VITE_API_URL=http://127.0.0.1:8000

# NOTE: the node-secretkey is no longer a frontend variable. Set `superSecretKey`
# on the Node backend and the ai-features service only.
