# Node/Express backend. Every browser request goes here: auth, trips, itinerary,
# and the proxy for recommendations, landmarks, image translation and weather.
# Leave unset to use the local default.
VITE_BACKEND_API_URL=http://localhost:3000

# NOTE: the frontend no longer calls the FastAPI ai-features service directly -
# it requires the node-secretkey, which must stay server-side. Set `superSecretKey`
# and `AI_FEATURES_URL` on the Node backend instead.
