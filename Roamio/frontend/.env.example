# Node/Express backend (auth, trips, itinerary). Leave unset to use the
# local default of http://127.0.0.1:3000.
VITE_BACKEND_API_URL=http://127.0.0.1:3000

# FastAPI ai-features service (weather, translator, recommendations, landmarks).
# Leave unset to use the local default of http://127.0.0.1:8000.
VITE_API_URL=http://127.0.0.1:8000

# Shared secret the ai-features service expects as the `node-secretkey` header.
VITE_TRANSLATION_SECRET_KEY=
