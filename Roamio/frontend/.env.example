# Node/Express backend. Every browser request goes here: auth, trips, itinerary,
# and the proxy for recommendations, landmarks, image translation and weather.
# Leave unset to use the local default.
VITE_BACKEND_API_URL=http://localhost:3000

# Google Analytics 4 measurement ID (G-XXXXXXX). Leave unset to turn tracking off.
# Must be set at build time, so it's separate from GA_MEASUREMENT_ID on the backend.
VITE_GA_MEASUREMENT_ID=

# Cloudflare Turnstile site key for the sign-up CAPTCHA. Leave unset to hide the
# widget. Public by design; its secret (TURNSTILE_SECRET_KEY) stays on the backend,
# and the two must be set together. Baked in at build time, so changing it
# needs a redeploy. Local testing: 1x00000000000000000000AA always passes,
# 2x00000000000000000000AB always fails.
VITE_TURNSTILE_SITE_KEY=

# NOTE: the frontend no longer calls the FastAPI ai-features service directly -
# it requires the node-secretkey, which must stay server-side. Set `superSecretKey`
# and `AI_FEATURES_URL` on the Node backend instead.
