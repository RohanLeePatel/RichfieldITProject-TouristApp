# Copy to .env and fill in what you need. Every name here is registered in
# config/settings.py (a test keeps the two in step). A key you leave out only
# switches its own feature off; the log says which at startup.

# Shared secret the Core API sends in the node-secretkey header. Must equal the
# Core API's superSecretKey. Without it every request is refused.
superSecretKey=

# Geoapify: landmarks, place search, and fetching a new destination's data
geoapifyAPIKey=
# OpenWeather: current weather and forecast
openWeatherAPIKey=
# DeepL: text translation
deepLAPIKey=
# OCR.space: reading text from photos
ocrSpaceAPIKey=
# FastForex: exchange rates for budgets in other currencies
exchangeRateAPIKey=
# TravelRiskAPI: country advisory levels for safety scores
TRAVEL_RISK_API_KEY_1=
# TravelRiskAPI base URL (default: https://travelriskapi.com/api/v1)
TRAVEL_RISK_API_URL_1=
# Google AI Studio: the trip chat assistant
geminiAPIKey=
# Gemini model name (default: gemini-3.5-flash)
geminiModel=

# Supabase: saved translation history and photos
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for translated photos (default: translation-images)
TRANSLATION_BUCKET_NAME=
