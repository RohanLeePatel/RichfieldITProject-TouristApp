// Mirrors the LIVE Supabase database (verified against information_schema on
// 2026-09-19) - the live DB is the source of truth. Only the tables this API
// uses are modelled; the rest (Destination, City, Notification, ...) exist in
// the DB and are simply not mapped here. Do NOT run `prisma migrate` against
// it: the files in prisma/migrations describe an older, different schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  fullName     String
  avatarUrl    String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  groupMemberships  TravelGroupMember[]
  tripMemberships   TripMember[]
  uploadedDocuments TripDocument[]
}

model TravelGroup {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  inviteCode  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  members TravelGroupMember[]
  trips   Trip[]
}

model TravelGroupMember {
  id            Int      @id @default(autoincrement())
  travelGroupId Int
  userId        Int
  role          String   @default("MEMBER")
  joinedAt      DateTime @default(now())

  travelGroup TravelGroup @relation(fields: [travelGroupId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
}

model Trip {
  id            Int       @id @default(autoincrement())
  travelGroupId Int
  title         String
  // The live Trip has no destination/budget/notes columns, so this API keeps
  // them as JSON in `description` (see routes/trips.js tripMeta helpers).
  description   String?
  startDate     DateTime?
  endDate       DateTime?
  status        String    @default("PLANNING")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  travelGroup TravelGroup     @relation(fields: [travelGroupId], references: [id])
  members     TripMember[]
  itinerary   ItineraryItem[]
  expenses    Expense[]
  documents   TripDocument[]
}

model TripMember {
  id       Int      @id @default(autoincrement())
  tripId   Int
  userId   Int
  role     String   @default("COLLABORATOR")
  joinedAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model ItineraryItem {
  id          String    @id
  tripId      Int
  title       String
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime?
  dayNumber   Int?      @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  trip Trip @relation(fields: [tripId], references: [id])
}

model Expense {
  id        String   @id
  tripId    Int
  title     String
  amount    Float
  category  String
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id])
}

// Booking confirmations, tickets and receipts attached to a trip. Added to the
// live DB by prisma/live-sql/001_trip_document.sql, then mirrored here.
// `data` holds the file itself - see that file for why, and when to move it out.
model TripDocument {
  id           String   @id
  tripId       Int
  uploadedById Int
  filename     String
  mimeType     String
  sizeBytes    Int
  kind         String   @default("OTHER")
  data         Bytes
  createdAt    DateTime @default(now())

  trip       Trip @relation(fields: [tripId], references: [id])
  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([tripId])
}
