datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. AUTHENTICATION, USERS & PROFILES
// -------------------------------------------------------------

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  fullName     String
  avatarUrl    String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Email OTP verification (hash only; the plain code is never stored)
  isVerified   Boolean   @default(false)
  otpHash      String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)

  // Agreement to the Terms and Privacy Policy (version = the wording agreed to)
  termsAcceptedAt DateTime?
  termsVersion    String?

  // Forgot-password OTP (hash only)
  resetPasswordOtpHash   String?
  resetPasswordExpiresAt DateTime?
  resetPasswordAttempts  Int       @default(0)

  preferences       UserPreference?
  groupMemberships  TravelGroupMember[]
  sentInvitations   Invitation[]        @relation("SenderInvitations")
  tripMemberships   TripMember[]
  chatConversations ChatConversation[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  plannerDraft      PlannerDraft?
  activityLogs      ActivityLog[]
  paidExpenses      Expense[]           @relation("ExpensePaidBy")
  expenseSplits     ExpenseSplit[]
  uploadedDocuments TripDocument[]
  notificationPrefs NotificationPreference?
  sessions          UserSession[]
  loginEvents       LoginEvent[]
  savedTravellers   SavedTraveller[]

  @@index([email])
}

model UserPreference {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency    String   @default("ZAR")
  language    String   @default("en")
  theme       String   @default("system")
  emailAlerts Boolean  @default(true)
  pushAlerts  Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// -------------------------------------------------------------
// 2. TRAVEL GROUPS, ROLES & INVITATIONS
// -------------------------------------------------------------

model TravelGroup {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  inviteCode  String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  members     TravelGroupMember[]
  invitations Invitation[]
  trips       Trip[]
}

model TravelGroupMember {
  id            Int         @id @default(autoincrement())
  travelGroupId Int
  travelGroup   TravelGroup @relation(fields: [travelGroupId], references: [id], onDelete: Cascade)
  userId        Int
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          String      @default("MEMBER") // "OWNER", "ADMIN", "MEMBER", "VIEWER"
  joinedAt      DateTime    @default(now())

  @@unique([travelGroupId, userId])
  @@index([travelGroupId])
  @@index([userId])
}

model Invitation {
  id            Int         @id @default(autoincrement())
  travelGroupId Int
  travelGroup   TravelGroup @relation(fields: [travelGroupId], references: [id], onDelete: Cascade)
  inviterId     Int
  inviter       User        @relation("SenderInvitations", fields: [inviterId], references: [id], onDelete: Cascade)
  email         String
  token         String      @unique
  status        String      @default("PENDING") // "PENDING", "ACCEPTED", "DECLINED", "EXPIRED"
  role          String      @default("MEMBER") // role granted on acceptance: "ADMIN", "MEMBER", "VIEWER"
  expiresAt     DateTime
  createdAt     DateTime    @default(now())

  @@index([token])
  @@index([email])
}

// -------------------------------------------------------------
// 3. TRIPS, LIFECYCLE & MEMBERS
// -------------------------------------------------------------

model Trip {
  id            Int         @id @default(autoincrement())
  travelGroupId Int
  travelGroup   TravelGroup @relation(fields: [travelGroupId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  startDate     DateTime?
  endDate       DateTime?
  status        String      @default("PLANNING") // "PLANNING", "CONFIRMED", "ONGOING", "COMPLETED", "CANCELLED"
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  members      TripMember[]
  destinations TripDestination[]
  activityLogs ActivityLog[]
  itineraries  ItineraryItem[]
  expenses     Expense[]
  budget       Budget?
  safetyAlerts SafetyAlert[]
  documents    TripDocument[]
  chatConversations ChatConversation[]

  @@index([travelGroupId])
  @@index([status])
}

model TripMember {
  id       Int      @id @default(autoincrement())
  tripId   Int
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId   Int
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("COLLABORATOR") // "ORGANIZER", "COLLABORATOR", "VIEWER"
  joinedAt DateTime @default(now())

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
}

// -------------------------------------------------------------
// 4. DESTINATIONS, GEOGRAPHY & TAGS
// -------------------------------------------------------------

model Country {
  id             Int             @id @default(autoincrement())
  code           String          @unique // ISO Alpha-2 (e.g. "ZA", "FR")
  name           String          @unique
  cities         City[]
  safetyAdvisory SafetyAdvisory?
}

model City {
  id           Int           @id @default(autoincrement())
  countryId    Int
  country      Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)
  name         String
  destinations Destination[]

  @@index([countryId])
}

model Destination {
  id               Int                     @id @default(autoincrement())
  cityId           Int
  city             City                    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  latitude         Float?
  longitude        Float?
  estimatedCost    Float?
  tags             DestinationTagMapping[]
  tripDestinations TripDestination[]

  safetyAlerts SafetyAlert[]

  @@index([cityId])
}

model DestinationTag {
  id           Int                     @id @default(autoincrement())
  name         String                  @unique
  destinations DestinationTagMapping[]
}

model DestinationTagMapping {
  destinationId Int
  destination   Destination    @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  tagId         Int
  tag           DestinationTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([destinationId, tagId])
}

// Trip document vault (tickets, bookings, receipts). Added to the live DB by
// prisma/live-sql/001_trip_document.sql; mirrored here so the schema matches
// the database and `prisma db push` never drops it.
model TripDocument {
  id           String   @id
  tripId       Int
  uploadedById Int
  filename     String
  mimeType     String
  sizeBytes    Int
  kind         String   @default("OTHER")
  data         Bytes
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  trip       Trip @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tripId])
}

model TripDestination {
  id            Int         @id @default(autoincrement())
  tripId        Int
  trip          Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destinationId Int
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  orderIndex    Int         @default(0)
  scheduledDay  Int?
  notes         String?
  createdAt     DateTime    @default(now())

  @@index([tripId])
  @@index([orderIndex])
}

// One advisory per country; destinations resolve it via City -> Country
model SafetyAdvisory {
  id         Int     @id @default(autoincrement())
  countryIso String  @unique // ISO alpha-3, matches Country.code (e.g. "ZAF")
  country    Country @relation(fields: [countryIso], references: [code], onDelete: Cascade)

  riskLevel         Int // 1 (normal) .. 4 (do not travel)
  compositeScore    Int // raw score from the provider
  advisoryLevel     String // short label, e.g. "Exercise increased caution"
  summary           String? // plain-text advisory description
  activeAlertsCount Int      @default(0)
  policeNumber      String?
  medicalNumber     String?
  source            String   @default("TRAVEL_RISK_API") // or "MOCK"
  lastUpdated       DateTime @default(now())

  @@index([riskLevel])
}

// Persisted risk alert for a trip + destination (deduplicated per risk level)
model SafetyAlert {
  id            Int         @id @default(autoincrement())
  tripId        Int
  trip          Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destinationId Int
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  riskLevel     Int
  message       String
  createdAt     DateTime    @default(now())
  resolvedAt    DateTime?

  @@unique([tripId, destinationId, riskLevel])
  @@index([tripId])
}

// -------------------------------------------------------------
// 5. NOTIFICATIONS, PUSH & AUDIT LOGS
// -------------------------------------------------------------

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // "INVITE", "TRIP_UPDATE", "ALERT", "INFO"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  tripId     Int?
  trip       Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  entityType String // "TRIP", "GROUP", "DESTINATION"
  entityId   Int?
  details    String?
  createdAt  DateTime @default(now())

  @@index([tripId])
  @@index([userId])
}

//-----------------------------------------
// ITINERARY
//-----------------------------------------

model ItineraryItem {
  id          String    @id @default(uuid())
  tripId      Int
  trip        Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title       String
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime?
  dayNumber   Int?      @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

//---------------------------------------
// EXPENSES & BUDGET
//---------------------------------------
enum ExpenseCategory {
  TRANSPORT
  FOOD
  ACCOMMODATION
  ACTIVITY
  MISC
}

enum SplitType {
  EQUAL
  EXACT
  PERCENT
}

model Expense {
  id        String          @id @default(uuid())
  tripId    Int
  title     String
  amount    Decimal         @db.Decimal(12, 2)
  currency  String          @default("ZAR")
  // 1 unit of `currency` in the budget currency when recorded; null = same
  // currency. Added by hand: prisma/live-sql/003_expense_exchange_rate.sql
  exchangeRate Decimal?     @db.Decimal(18, 8)
  category  ExpenseCategory
  splitType SplitType       @default(EQUAL)
  paidById  Int
  date      DateTime        @default(now())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  trip   Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy User           @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: Cascade)
  splits ExpenseSplit[]

  @@index([tripId])
  @@index([tripId, category])
  @@index([paidById])
}

model ExpenseSplit {
  id          Int     @id @default(autoincrement())
  expenseId   String
  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId      Int
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareAmount Decimal @db.Decimal(12, 2)
  isSettled   Boolean @default(false)

  @@unique([expenseId, userId])
  @@index([userId])
}

model Budget {
  id          Int      @id @default(autoincrement())
  tripId      Int      @unique
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  totalAmount Decimal  @db.Decimal(12, 2)
  currency    String   @default("ZAR")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryLimits BudgetCategoryLimit[]
}

model BudgetCategoryLimit {
  id          Int             @id @default(autoincrement())
  budgetId    Int
  budget      Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  limitAmount Decimal         @db.Decimal(12, 2)

  @@unique([budgetId, category])
}

// Saved translations for the Translator page. Added to the live DB by
// prisma/live-sql/002_translation_history.sql, then mirrored here. Written and
// read by ai-features over PostgREST, not by this API - mirrored only so the
// schema stays a true picture of the live database.
model translation_history {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String?
  translation_type String
  source_text      String?
  translated_text  String?
  ocr_data         Json?
  source_lang      String?
  detected_lang    String?
  target_lang      String
  image_url        String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, created_at(sort: Desc)], map: "translation_history_user_created_idx")
}

// Saved chats with the trip assistant. Added to the live DB by
// prisma/live-sql/004_chat.sql, then mirrored here.
model ChatConversation {
  id        Int           @id @default(autoincrement())
  userId    Int
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId    Int?
  trip      Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now())
  messages  ChatMessage[]

  @@index([userId, updatedAt(sort: Desc)])
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime         @default(now())

  @@index([conversationId, id])
}

// Settings page tables. Added to the live DB by prisma/live-sql/006_settings.sql,
// then mirrored here.
// The trip planner's unfinished plan, one per user, so it follows them between
// devices. data is the page's own snapshot.
model PlannerDraft {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model NotificationPreference {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prefs     Json
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
}

// One row per sign-in. The refresh token carries id; revokedAt ends it.
model UserSession {
  id         String    @id
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  browser    String    @default("")
  os         String    @default("")
  deviceType String    @default("desktop")
  location   String    @default("")
  ipAddress  String    @default("")
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)

  @@index([userId, lastSeenAt(sort: Desc)])
}

model LoginEvent {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  at         DateTime @default(now()) @db.Timestamptz(6)
  browser    String   @default("")
  os         String   @default("")
  deviceType String   @default("desktop")
  location   String   @default("")
  ipAddress  String   @default("")
  success    Boolean

  @@index([userId, at(sort: Desc)])
}

// Passport / ID numbers are never stored: documentLast4 is all we keep.
model SavedTraveller {
  id              String   @id
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  relationship    String
  dateOfBirth     DateTime @db.Date
  nationality     String   @default("")
  email           String   @default("")
  phone           String   @default("")
  documentType    String   @default("passport")
  documentLast4   String?
  documentExpiry  DateTime? @db.Date
  consentGiven    Boolean
  consentGuardian Boolean  @default(false)
  consentAt       DateTime @default(now()) @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt])
}
