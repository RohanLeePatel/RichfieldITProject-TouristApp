# Roamio Node/Express backend. Copy to .env and fill in.

# --- Database (Supabase) ---
# Pooled connection used by the app (port 6543, ?pgbouncer=true)
DATABASE_URL=
# Direct connection used by Prisma CLI commands (port 5432)
DIRECT_URL=

# --- Auth ---
# Required in production: the code falls back to a public default otherwise
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=

# --- Column-level encryption (documents, push keys, saved travellers, sign-in IP/location) ---
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Set the same value in Vercel. Back it up: losing it makes the encrypted columns unrecoverable.
APP_ENCRYPTION_KEY=
# The frontend keeps the access token in localStorage and has no refresh flow,
# so a short lifetime logs people out mid-session. 7d matches the old backend.
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# --- Email (2FA sign-up and password-reset codes) ---
# Any SMTP provider. Without SMTP_HOST, codes are printed to the console in
# development and sign-up is refused (503) in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Roamio <no-reply@example.com>"
# Where "Report a problem" in Settings is sent (same SMTP settings as above)
SUPPORT_EMAIL=support.roamiio.live@gmail.com
# Development only: return the code in the register response
ENABLE_DEV_OTP=false

# --- Sign-up CAPTCHA (Cloudflare Turnstile) ---
# Secret key, checked server-side on POST /api/auth/register. Leave unset to turn
# the check off. Set it together with VITE_TURNSTILE_SITE_KEY on the frontend -
# one without the other blocks (or skips) every sign-up.
# Local testing: 1x0000000000000000000000000000000AA always passes,
# 2x0000000000000000000000000000000AA always fails (Cloudflare's test keys).
TURNSTILE_SECRET_KEY=

# --- Frontend ---
# Allowed browser origins, comma-separated (e.g. the Vercel site)
CLIENT_URL=http://localhost:5173
PORT=3000

# --- AI features service (translation, recommendations, weather proxies) ---
AI_FEATURES_URL=https://richfield-it-project-tourist-app.vercel.app
# Must match the ai-features service's key
superSecretKey=

# --- Safety advisories ---
TRAVEL_RISK_API_KEY_1=
TRAVEL_RISK_API_URL_1=
SAFETY_SYNC_MODE=

# --- Admin dashboard (/api/admin/*) ---
# Comma-separated user ids allowed in. No ids = nobody (fails closed).
ADMIN_USER_IDS=

# GA4 Data API (server-to-server). The service account needs Viewer access on the property.
GA_PROPERTY_ID=
# Local: path to the key file. Hosted (Vercel): set GOOGLE_CREDENTIALS_JSON to the whole JSON on one line (takes priority).
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
GOOGLE_CREDENTIALS_JSON=
# Public ids handed to the dashboard by /api/admin/config/tracking
CLARITY_PROJECT_ID=
GA_MEASUREMENT_ID=
# Service health checks (/api/admin/health/services)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEEPL_API_KEY=
# Same keys the ai-features service uses (it names them geminiAPIKey, openWeatherAPIKey, ...)
GEMINI_API_KEY=
OPENWEATHER_API_KEY=
GEOAPIFY_API_KEY=
FASTFOREX_API_KEY=

NODE_ENV=development

# Vercel Cron sends this as "Authorization: Bearer ..." to /api/cron/*; with it
# unset those routes answer 503. Any long random string, set in Vercel too.
CRON_SECRET=

# --- Web Push (browser notifications) ---
# Generate once with: npx web-push generate-vapid-keys   (set the same values in Vercel)
# Without them push is off; notifications still reach the in-app inbox.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: address push services can contact, e.g. mailto:support@yourdomain.com
VAPID_SUBJECT=
