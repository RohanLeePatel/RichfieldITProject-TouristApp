# Roamio Node/Express backend. Copy to .env and fill in.

# --- Database (Supabase) ---
# Pooled connection used by the app (port 6543, ?pgbouncer=true)
DATABASE_URL=
# Direct connection used by Prisma CLI commands (port 5432)
DIRECT_URL=

# --- Auth ---
# Required in production: the code falls back to a public default otherwise
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
# The frontend keeps the access token in localStorage and has no refresh flow,
# so a short lifetime logs people out mid-session. 7d matches the old backend.
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# --- Email (2FA sign-up and password-reset codes) ---
# Any SMTP provider. Without SMTP_HOST, codes are printed to the console in
# development and sign-up is refused (503) in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Roamio <no-reply@example.com>"
# Development only: return the code in the register response
ENABLE_DEV_OTP=false

# --- Frontend ---
# Allowed browser origins, comma-separated (e.g. the Vercel site)
CLIENT_URL=http://localhost:5173
PORT=3000

# --- AI features service (translation, recommendations, weather proxies) ---
AI_FEATURES_URL=https://richfield-it-project-tourist-app.vercel.app
# Must match the ai-features service's key
superSecretKey=

# --- Safety advisories ---
TRAVEL_RISK_API_KEY=
TRAVEL_RISK_API_URL=
SAFETY_SYNC_MODE=

NODE_ENV=development
