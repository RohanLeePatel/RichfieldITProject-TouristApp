# Copy this file to .env (already git-ignored) and adjust as needed.
# .env is loaded by docker-compose.yml via `env_file: .env` for backend, ai-services, and frontend.

# ---- Postgres ----
POSTGRES_USER=famplanner
POSTGRES_PASSWORD=famplanner
POSTGRES_DB=famplanner
DATABASE_URL=postgresql://famplanner:famplanner@postgres:5432/famplanner

# ---- Backend (Node/Express) — Backend Dev 1 / Backend Dev 2 ----
PORT=4000
JWT_SECRET=replace-me-with-a-real-secret
AI_SERVICE_URL=http://ai-services:8000

# ---- AI service (FastAPI) — AI & OCR Lead ----
# LIBRETRANSLATE_URL=http://libretranslate:5000   # add when the translation client is wired up (Week 7)

# ---- Frontend (Vite) — Frontend Dev 1 / Frontend Dev 2 ----
VITE_API_URL=http://localhost:4000
